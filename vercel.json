{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/imagens/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/t/:path*",
      "destination": "https://cashflow.mentoriaprocesso.com/t/:path*"
    }
  ]
}
